{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stayboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "stayboard", "database_id": "9ad0ba95-d527-4040-b7df-9b69b3edc8f5", "migrations_dir": "migrations" }],
  "vars": { "AWS_REGION": "us-east-1", "MODEL_ID": "us.amazon.nova-2-lite-v1:0", "APP_URL": "https://stayboard.kalashshah47.workers.dev" },
  "observability": { "enabled": true }
}
